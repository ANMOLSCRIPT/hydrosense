# ---------------------------------------------------------------------------
# HydroSense environment variables. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Frontend (safe to expose: these are public by design) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Leave empty when the API is served from the same origin (Vercel, or the Vite dev proxy).
VITE_API_URL=

# --- Backend (SERVER SIDE ONLY - never prefix these with VITE_) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: direct Postgres URL, only used by scripts/apply_schema.py
DATABASE_URL=
# Optional: if set, the ESP32 must send this value in the X-Device-Key header.
INGEST_API_KEY=
# Optional: enables LLM-written explanations. HydroSense works fully without it.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Optional: comma-separated allowed origins for the API (default: *)
CORS_ORIGINS=*
